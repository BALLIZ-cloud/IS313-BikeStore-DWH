      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B4784DD4-03A7-406E-854F-18660169A066}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @StartDate DATE = '2016-01-01';&#xA;DECLARE @EndDate DATE = '2018-12-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;&#xA;    INSERT INTO Dim_Date (&#xA;        FullDate,&#xA;        [Year],&#xA;        [Quarter],&#xA;        [Month],&#xA;        [MonthName],&#xA;        [Day],&#xA;        [DayOfWeekName],&#xA;        [IsWeekend]&#xA;    )&#xA;&#xA;    VALUES (&#xA;        @StartDate,&#xA;        YEAR(@StartDate),&#xA;        DATEPART(QUARTER, @StartDate),&#xA;        MONTH(@StartDate),&#xA;        DATENAME(MONTH, @StartDate),&#xA;        DAY(@StartDate),&#xA;        DATENAME(WEEKDAY, @StartDate),&#xA;&#xA;        CASE&#xA;            WHEN DATENAME(WEEKDAY, @StartDate) &#xA;                 IN ('Saturday', 'Sunday')&#xA;            THEN 1&#xA;            ELSE 0&#xA;        END&#xA;    );&#xA;&#xA;    SET @StartDate = DATEADD(DAY, 1, @StartDate);&#xA;&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
